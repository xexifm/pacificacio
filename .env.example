# PostgreSQL connection string (Neon, Supabase, or local Postgres)
# Example (local): postgresql://postgres:postgres@localhost:5432/pacificacio
# Example (Neon):  postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/db?sslmode=require
DATABASE_URL=

# Initial admin password. Used only until an admin password hash is stored in the
# database (first successful login with this value seeds the hash). Defaults to "CORNELLA".
ADMIN_PASSWORD=CORNELLA

# Optional: admin email used to gate the password-reset flow. When unset, reset
# requests still return success but no reset token is generated.
ADMIN_EMAIL=

# Optional: public base URL used to build password-reset links in logs.
# Defaults to http://localhost:3000
APP_BASE_URL=http://localhost:3000
